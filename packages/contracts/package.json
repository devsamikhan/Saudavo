{
  "name": "@saudavo/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Single-source Zod schemas, shared enums, and API contracts for Saudavo",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@saudavo/config": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
