  lineTotalPaisa       BigInt  @map("line_total_paisa")
  currency             String  @default("PKR") @db.Char(3)

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  reviews        Review[]

  @@map("order_items")
}

model ServiceOrderDetails {
  id                           String    @id @default(uuid()) @db.Uuid
  orderId                      String    @unique @map("order_id") @db.Uuid
  serviceListingId             String    @map("service_listing_id") @db.Uuid
  servicePackageId             String    @map("service_package_id") @db.Uuid
  serviceModeSnapshot          String    @map("service_mode_snapshot") @db.VarChar(20)
  serviceTitleSnapshot         String    @map("service_title_snapshot") @db.VarChar(200)
  packageNameSnapshot          String    @map("package_name_snapshot") @db.VarChar(60)
  packagePricePaisa            BigInt    @map("package_price_paisa")
  deliveryEstimateDaysSnapshot Int       @map("delivery_estimate_days_snapshot")
