// ============================================================================
// 5. PAYMENTS, COMMISSION LEDGER & SETTLEMENTS
// ============================================================================

model Payment {
  id                      String    @id @default(uuid()) @db.Uuid
  orderId                 String    @map("order_id") @db.Uuid
  providerCode            String    @default("COD_MANUAL") @map("provider_code") @db.VarChar(40)
  paymentMethod           String    @default("COD") @map("payment_method") @db.VarChar(20)
  status                  String    @db.VarChar(30)
  amountPaisa             BigInt    @map("amount_paisa")
  currency                String    @default("PKR") @db.Char(3)
  manualPaymentMethodDesc String?   @map("manual_payment_method_desc") @db.VarChar(100)
  confirmationNote        String?   @map("confirmation_note")
  providerReference       String?   @map("provider_reference") @db.VarChar(140)
  confirmedById           String?   @map("confirmed_by_id") @db.Uuid
  collectedAt             DateTime? @map("collected_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  confirmedBy User?          @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  events      PaymentEvent[]
  refunds     Refund[]

  @@index([orderId], map: "idx_payments_order_id")
  @@map("payments")
}

model PaymentEvent {
  id             String   @id @default(uuid()) @db.Uuid
  paymentId      String   @map("payment_id") @db.Uuid
  eventType      String   @map("event_type") @db.VarChar(60)
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(120)
  rawPayloadJson Json     @map("raw_payload_json") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@map("payment_events")
}

model Refund {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  paymentId    String   @map("payment_id") @db.Uuid
  amountPaisa  BigInt   @map("amount_paisa")
  reason       String
  status       String   @db.VarChar(30)
  approvedById String?  @map("approved_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order      Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  approvedBy User?   @relation("RefundApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("refunds")
}

model CommissionRule {
  id                 String    @id @default(uuid()) @db.Uuid
  version            Int
  name               String    @db.VarChar(100)
  scopeType          String    @map("scope_type") @db.VarChar(20)
  categoryId         String?   @map("category_id") @db.Uuid
  orderType          String?   @map("order_type") @db.VarChar(20)
  rateBps            Int       @map("rate_bps")
  includeDeliveryFee Boolean   @default(false) @map("include_delivery_fee")
  effectiveFrom      DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo        DateTime? @map("effective_to") @db.Timestamptz(6)
  isActive           Boolean   @default(true) @map("is_active")
  createdById        String    @map("created_by_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  category          Category?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy         User               @relation("CommissionRuleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  orders            Order[]
  commissionLedgers CommissionLedger[]

  @@map("commission_rules")
}

model CommissionLedger {
  id                        String   @id @default(uuid()) @db.Uuid
  orderId                   String   @map("order_id") @db.Uuid
  storeId                   String   @map("store_id") @db.Uuid
  commissionRuleId          String   @map("commission_rule_id") @db.Uuid
  entryType                 String   @map("entry_type") @db.VarChar(30)
  grossOrderPaisa           BigInt   @map("gross_order_paisa")
  commissionableBasePaisa   BigInt   @map("commissionable_base_paisa")
  rateBps                   Int      @map("rate_bps")
  commissionPaisa           BigInt   @map("commission_paisa")
  sellerNetEntitlementPaisa BigInt   @map("seller_net_entitlement_paisa")
  currency                  String   @default("PKR") @db.Char(3)
  referenceEntryId          String?  @map("reference_entry_id") @db.Uuid
  reason                    String
  createdById               String?  @map("created_by_id") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order          Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  store          Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  commissionRule CommissionRule     @relation(fields: [commissionRuleId], references: [id], onDelete: Restrict)
  referenceEntry CommissionLedger?  @relation("LedgerReference", fields: [referenceEntryId], references: [id], onDelete: Restrict)
  adjustments    CommissionLedger[] @relation("LedgerReference")
  createdBy      User?              @relation("LedgerEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt], map: "idx_ledger_store_created")
  @@index([orderId], map: "idx_ledger_order")
  @@map("commission_ledger")
}

model SellerSettlementRecord {
  id                String   @id @default(uuid()) @db.Uuid
  storeId           String   @map("store_id") @db.Uuid
  direction         String   @db.VarChar(30)
  settlementMethod  String   @map("settlement_method") @db.VarChar(40)
  amountPaisa       BigInt   @map("amount_paisa")
  currency          String   @default("PKR") @db.Char(3)
  externalReference String?  @map("external_reference") @db.VarChar(140)
  periodStart       DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd         DateTime @map("period_end") @db.Timestamptz(6)
  status            String   @db.VarChar(20)
  verifiedById      String?  @map("verified_by_id") @db.Uuid
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store      Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  verifiedBy User? @relation("SettlementVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@map("seller_settlement_records")
}

// ============================================================================
// 6. REVIEWS, MODERATION, NOTIFICATIONS, IDEMPOTENCY & AUDIT
// ============================================================================

model Review {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  orderItemId String?  @map("order_item_id") @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  rating      Int      @db.SmallInt
  comment     String?
  status      String   @default("PUBLISHED") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer  User       @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@map("reviews")
}

model Report {
  id             String   @id @default(uuid()) @db.Uuid
  reporterId     String   @map("reporter_id") @db.Uuid
  targetType     String   @map("target_type") @db.VarChar(30)
  targetId       String   @map("target_id") @db.Uuid
  reasonCode     String   @map("reason_code") @db.VarChar(40)
  details        String
  status         String   @default("OPEN") @db.VarChar(20)
  resolvedById   String?  @map("resolved_by_id") @db.Uuid
  resolutionNote String?  @map("resolution_note")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter   User  @relation("ReportSubmitter", fields: [reporterId], references: [id], onDelete: Restrict)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@map("reports")
}

model Dispute {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  openedById        String   @map("opened_by_id") @db.Uuid
  disputeType       String   @map("dispute_type") @db.VarChar(40)
  description       String
  status            String   @default("OPEN") @db.VarChar(30)
  resolutionOutcome String?  @map("resolution_outcome") @db.VarChar(40)
  resolvedById      String?  @map("resolved_by_id") @db.Uuid
  resolutionNote    String?  @map("resolution_note")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  openedBy   User  @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Restrict)
  resolvedBy User? @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@map("disputes")
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(60)
  titleKey    String    @map("title_key") @db.VarChar(100)
  payloadJson Json      @map("payload_json") @db.JsonB
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)], map: "idx_notifications_user_unread")
  @@map("notifications")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(80)
  aggregateType String?   @map("aggregate_type") @db.VarChar(40)
  aggregateId   String?   @map("aggregate_id") @db.Uuid
  payloadJson   Json      @map("payload_json") @db.JsonB
  status        String    @default("PENDING") @db.VarChar(20)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt], map: "idx_outbox_pending")
  @@map("outbox_events")
}

model IdempotencyKey {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  endpoint         String   @db.VarChar(120)
  keyValue         String   @map("key_value") @db.VarChar(128)
  requestHash      String   @map("request_hash") @db.VarChar(64)
  responseStatus   Int?     @map("response_status")
  responseBodyJson Json?    @map("response_body_json") @db.JsonB
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint, keyValue])
  @@map("idempotency_keys")
}

model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actorRole  String   @map("actor_role") @db.VarChar(30)
  action     String   @db.VarChar(80)
  targetType String   @map("target_type") @db.VarChar(40)
  targetId   String   @map("target_id") @db.Uuid
  reason     String?
  beforeJson Json?    @map("before_json") @db.JsonB
  afterJson  Json?    @map("after_json") @db.JsonB
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt], map: "idx_audit_target_created")
  @@map("admin_audit_logs")
}

// ============================================================================
// 7. IN-APP SHOPPING MESSENGER & MONTHLY SELLER SUBSCRIPTIONS
// ============================================================================

model Conversation {
  id               String    @id @default(uuid()) @db.Uuid
  buyerId          String    @map("buyer_id") @db.Uuid
  storeId          String    @map("store_id") @db.Uuid
  productId        String?   @map("product_id") @db.Uuid
  serviceListingId String?   @map("service_listing_id") @db.Uuid
  status           String    @default("OPEN") @db.VarChar(20)
  lastMessageAt    DateTime  @default(now()) @map("last_message_at") @db.Timestamptz(6)
  buyerLastReadAt  DateTime? @map("buyer_last_read_at") @db.Timestamptz(6)
  sellerLastReadAt DateTime? @map("seller_last_read_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  buyer          User            @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Restrict)
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  serviceListing ServiceListing? @relation(fields: [serviceListingId], references: [id], onDelete: SetNull)
  messages       ChatMessage[]

  @@unique([buyerId, storeId])
  @@index([buyerId, lastMessageAt(sort: Desc)], map: "idx_conversations_buyer_last")
  @@index([storeId, lastMessageAt(sort: Desc)], map: "idx_conversations_store_last")
  @@map("conversations")
}

model ChatMessage {
  id                    String    @id @default(uuid()) @db.Uuid
  conversationId        String    @map("conversation_id") @db.Uuid
  senderId              String    @map("sender_id") @db.Uuid
  senderRole            String    @map("sender_role") @db.VarChar(20)
  messageType           String    @default("TEXT") @map("message_type") @db.VarChar(30)
  body                  String
  productId             String?   @map("product_id") @db.Uuid
  serviceListingId      String?   @map("service_listing_id") @db.Uuid
  mediaAssetId          String?   @map("media_asset_id") @db.Uuid
  voiceDurationSec      Int?      @map("voice_duration_sec")
  offerTitle            String?   @map("offer_title") @db.VarChar(200)
  offerQuantity         Int?      @map("offer_quantity")
  offerUnitPricePaisa   BigInt?   @map("offer_unit_price_paisa")
  offerDeliveryFeePaisa BigInt?   @map("offer_delivery_fee_paisa")
  offerFulfilmentMode   String?   @map("offer_fulfilment_mode") @db.VarChar(30)
  offerStatus           String?   @map("offer_status") @db.VarChar(20)
  offerOrderId          String?   @map("offer_order_id") @db.Uuid
  offerExpiresAt        DateTime? @map("offer_expires_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User            @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  serviceListing ServiceListing? @relation(fields: [serviceListingId], references: [id], onDelete: SetNull)
  mediaAsset     MediaAsset?     @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  offerOrder     Order?          @relation("AcceptedOfferOrder", fields: [offerOrderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt], map: "idx_chat_messages_conv_created")
  @@map("chat_messages")
}

model SubscriptionPlan {
  id                   String   @id @default(uuid()) @db.Uuid
  code                 String   @unique @db.VarChar(40)
  nameEn               String   @map("name_en") @db.VarChar(80)
  nameUr               String   @map("name_ur") @db.VarChar(80)
  descriptionEn        String   @map("description_en")
  descriptionUr        String   @map("description_ur")
  pricePaisa           BigInt   @map("price_paisa")
  currency             String   @default("PKR") @db.Char(3)
  durationDays         Int      @default(30) @map("duration_days")
  maxActiveProducts    Int      @map("max_active_products")
  maxActiveServices    Int      @map("max_active_services")
  hasVerifiedBadge     Boolean  @default(false) @map("has_verified_badge")
  hasPriorityPlacement Boolean  @default(false) @map("has_priority_placement")
  hasCustomOffers      Boolean  @default(true) @map("has_custom_offers")
  isActive             Boolean  @default(true) @map("is_active")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  storeSubscriptions StoreSubscription[]
  renewalRequests    SubscriptionRenewalRequest[]

  @@map("subscription_plans")
}

model StoreSubscription {
  id                 String    @id @default(uuid()) @db.Uuid
  storeId            String    @unique @map("store_id") @db.Uuid
  planId             String    @map("plan_id") @db.Uuid
  status             String    @default("ACTIVE") @db.VarChar(20)
  currentPeriodStart DateTime  @default(now()) @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz(6)
  graceEndsAt        DateTime? @map("grace_ends_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan  SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("store_subscriptions")
}

model SubscriptionRenewalRequest {
  id                   String    @id @default(uuid()) @db.Uuid
  storeId              String    @map("store_id") @db.Uuid
  planId               String    @map("plan_id") @db.Uuid
  submittedById        String    @map("submitted_by_id") @db.Uuid
  amountPaisa          BigInt    @map("amount_paisa")
  currency             String    @default("PKR") @db.Char(3)
  paymentMethod        String    @map("payment_method") @db.VarChar(40)
  transactionReference String    @map("transaction_reference") @db.VarChar(140)
  payerAccountNote     String?   @map("payer_account_note") @db.VarChar(200)
  status               String    @default("PENDING") @db.VarChar(20)
  reviewedById         String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt           DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote           String?   @map("review_note")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  store       Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  submittedBy User             @relation("RenewalSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  User?            @relation("RenewalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([storeId, status, createdAt(sort: Desc)], map: "idx_sub_renewals_store_status")
  @@map("subscription_renewal_requests")
}

model PlatformFeatureFlag {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique @db.VarChar(80)
  nameEn        String   @map("name_en") @db.VarChar(100)
  nameUr        String   @map("name_ur") @db.VarChar(100)
  descriptionEn String   @map("description_en")
  descriptionUr String   @map("description_ur")
  category      String   @db.VarChar(40)
  isEnabled     Boolean  @default(false) @map("is_enabled")
  sortOrder     Int      @default(0) @map("sort_order")
  updatedById   String?  @map("updated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation("FeatureFlagUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("feature_flags")
}

model BuyerRequest {
  id             String   @id @default(uuid()) @db.Uuid
  buyerId        String   @map("buyer_id") @db.Uuid
  districtId     String   @map("district_id") @db.Uuid
  areaZoneId     String?  @map("area_zone_id") @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  title          String   @db.VarChar(180)
  description    String
  budgetMaxPaisa BigInt   @map("budget_max_paisa")
  status         String   @default("OPEN") @db.VarChar(20)
  responsesCount Int      @default(0) @map("responses_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  buyer    User      @relation("BuyerRequests", fields: [buyerId], references: [id], onDelete: Cascade)
  district District  @relation(fields: [districtId], references: [id], onDelete: Restrict)
  areaZone AreaZone? @relation(fields: [areaZoneId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([districtId, status, createdAt(sort: Desc)], map: "idx_buyer_requests_district_status")
  @@map("buyer_requests")
}

model StorePromoDeal {
  id            String   @id @default(uuid()) @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  code          String?  @db.VarChar(40)
  title         String   @db.VarChar(140)
  discountType  String   @map("discount_type") @db.VarChar(20)
  discountValue BigInt   @map("discount_value")
  minOrderPaisa BigInt   @default(0) @map("min_order_paisa")
  isFlashDeal   Boolean  @default(false) @map("is_flash_deal")
  startsAt      DateTime @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime @map("ends_at") @db.Timestamptz(6)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code], map: "uq_store_promo_code")
  @@index([isActive, endsAt], map: "idx_store_promo_active_ends")
  @@map("store_promo_deals")
}
