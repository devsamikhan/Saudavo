  revisionsUsed                Int       @default(0) @map("revisions_used")
  areaZoneId                   String?   @map("area_zone_id") @db.Uuid
  serviceAddressSnapshotJson   Json?     @map("service_address_snapshot_json") @db.JsonB
  customerRequirements         String    @map("customer_requirements")
  deliverySummary              String?   @map("delivery_summary")
  deliverySubmittedAt          DateTime? @map("delivery_submitted_at") @db.Timestamptz(6)
  customerAcceptedAt           DateTime? @map("customer_accepted_at") @db.Timestamptz(6)

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  serviceListing ServiceListing @relation(fields: [serviceListingId], references: [id], onDelete: Restrict)
  servicePackage ServicePackage @relation(fields: [servicePackageId], references: [id], onDelete: Restrict)
  areaZone       AreaZone?      @relation(fields: [areaZoneId], references: [id], onDelete: SetNull)

  @@map("service_order_details")
}

model Delivery {
  id                          String    @id @default(uuid()) @db.Uuid
  orderId                     String    @unique @map("order_id") @db.Uuid
  fulfilmentMode              String    @map("fulfilment_mode") @db.VarChar(30)
  deliveryStatus              String    @default("NOT_STARTED") @map("delivery_status") @db.VarChar(30)
  areaZoneId                  String?   @map("area_zone_id") @db.Uuid
