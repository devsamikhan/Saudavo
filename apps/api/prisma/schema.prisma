generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. IDENTITY, ROLES & PROFILES
// ============================================================================

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String?   @unique @db.VarChar(255)
  phoneE164          String?   @unique @map("phone_e164") @db.VarChar(20)
  passwordHash       String    @map("password_hash")
  displayName        String    @map("display_name") @db.VarChar(120)
  status             String    @default("ACTIVE") @db.VarChar(20)
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt    DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  mfaSecretEncrypted String?   @map("mfa_secret_encrypted")
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  userRoles               UserRole[]               @relation("UserAssignedRoles")
  assignedRoles           UserRole[]               @relation("UserRoleAssigner")
  sessions                UserSession[]
  authTokens              AuthToken[]
  customerProfile         CustomerProfile?
  sellerProfile           SellerProfile?
  verifiedSellerProfiles  SellerProfile[]          @relation("SellerProfileVerifier")
  addresses               Address[]
  mediaAssets             MediaAsset[]
  carts                   Cart[]
  ordersAsCustomer        Order[]                  @relation("CustomerOrders")
  orderStatusChanges      OrderStatusHistory[]
  orderMessages           OrderMessage[]
  confirmedPayments       Payment[]                @relation("PaymentConfirmer")
  approvedRefunds         Refund[]                 @relation("RefundApprover")
  createdCommissionRules  CommissionRule[]         @relation("CommissionRuleCreator")
  createdLedgerEntries    CommissionLedger[]       @relation("LedgerEntryCreator")
  verifiedSettlements     SellerSettlementRecord[] @relation("SettlementVerifier")
  reviews                 Review[]
  reports                 Report[]                 @relation("ReportSubmitter")
  resolvedReports         Report[]                 @relation("ReportResolver")
  openedDisputes          Dispute[]                @relation("DisputeOpener")
  resolvedDisputes        Dispute[]                @relation("DisputeResolver")
  notifications           Notification[]
  idempotencyKeys         IdempotencyKey[]
  adminAuditLogs          AdminAuditLog[]
  buyerConversations      Conversation[]               @relation("BuyerConversations")
  chatMessages            ChatMessage[]                @relation("ChatMessageSender")
  submittedRenewals       SubscriptionRenewalRequest[] @relation("RenewalSubmitter")
  reviewedRenewals        SubscriptionRenewalRequest[] @relation("RenewalReviewer")
  updatedFeatureFlags     PlatformFeatureFlag[]        @relation("FeatureFlagUpdater")
  buyerRequests           BuyerRequest[]               @relation("BuyerRequests")

  @@index([status], map: "idx_users_status")
  @@map("users")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(30)
  description String
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User  @relation("UserAssignedRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("UserRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(128)
  csrfTokenHash String    @map("csrf_token_hash") @db.VarChar(128)
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  ipAddress     String?   @map("ip_address") @db.Inet
  userAgent     String?   @map("user_agent")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_sessions_user_id")
  @@index([expiresAt], map: "idx_user_sessions_expires_at")
  @@map("user_sessions")
}

model AuthToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenType String    @map("token_type") @db.VarChar(30)
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenType], map: "idx_auth_tokens_user_type")
  @@index([expiresAt], map: "idx_auth_tokens_expires")
  @@map("auth_tokens")
}

model CustomerProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  preferredLocale   String   @default("en") @map("preferred_locale") @db.VarChar(5)
  defaultDistrictId String?  @map("default_district_id") @db.Uuid
  defaultAreaZoneId String?  @map("default_area_zone_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultDistrict District? @relation(fields: [defaultDistrictId], references: [id], onDelete: SetNull)
  defaultAreaZone AreaZone? @relation(fields: [defaultAreaZoneId], references: [id], onDelete: SetNull)

  @@map("customer_profiles")
}

model SellerProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  sellerType         String    @map("seller_type") @db.VarChar(30)
  verificationStatus String    @default("PENDING_REVIEW") @map("verification_status") @db.VarChar(30)
  rejectionReason    String?   @map("rejection_reason")
  moderationNotes    String?   @map("moderation_notes")
  verifiedById       String?   @map("verified_by_id") @db.Uuid
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  verifiedBy User?   @relation("SellerProfileVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  stores     Store[]

  @@map("seller_profiles")
}

// ============================================================================
// 2. GEOGRAPHY, STORES & ADDRESSES
// ============================================================================

model District {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(30)
  nameEn      String   @map("name_en") @db.VarChar(100)
  nameUr      String   @map("name_ur") @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  province    String   @db.VarChar(80)
  countryCode String   @default("PK") @map("country_code") @db.Char(2)
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  areaZones        AreaZone[]
  customerProfiles CustomerProfile[]
  stores           Store[]
  addresses        Address[]
  orders           Order[]
  buyerRequests    BuyerRequest[]

  @@map("districts")
}

model AreaZone {
  id         String   @id @default(uuid()) @db.Uuid
  districtId String   @map("district_id") @db.Uuid
  nameEn     String   @map("name_en") @db.VarChar(100)
  nameUr     String   @map("name_ur") @db.VarChar(100)
  slug       String   @db.VarChar(100)
  zoneType   String   @map("zone_type") @db.VarChar(30)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  district            District             @relation(fields: [districtId], references: [id], onDelete: Restrict)
  customerProfiles    CustomerProfile[]
  storeServiceAreas   StoreServiceArea[]
  addresses           Address[]
  deliveries          Delivery[]
  serviceOrderDetails ServiceOrderDetails[]
  buyerRequests       BuyerRequest[]

  @@unique([districtId, slug])
  @@index([districtId, isActive], map: "idx_area_zones_district_active")
  @@map("area_zones")
}

model Store {
  id                      String    @id @default(uuid()) @db.Uuid
  sellerProfileId         String    @map("seller_profile_id") @db.Uuid
  districtId              String    @map("district_id") @db.Uuid
  slug                    String    @unique @db.VarChar(120)
  displayName             String    @map("display_name") @db.VarChar(140)
  description             String?
  logoAssetId             String?   @map("logo_asset_id") @db.Uuid
  bannerAssetId           String?   @map("banner_asset_id") @db.Uuid
  showPublicPhone         Boolean   @default(false) @map("show_public_phone")
  publicContactPhone      String?   @map("public_contact_phone") @db.VarChar(20)
  showPublicAddress       Boolean   @default(false) @map("show_public_address")
  publicBusinessAddress   String?   @map("public_business_address")
  defaultDeliveryFeePaisa BigInt    @default(0) @map("default_delivery_fee_paisa")
  requireCleanCodHistory  Boolean   @default(false) @map("require_clean_cod_history")
  currency                String    @default("PKR") @db.Char(3)
  status                  String    @default("DRAFT") @db.VarChar(30)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(6)

  sellerProfile     SellerProfile            @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  district          District                 @relation(fields: [districtId], references: [id], onDelete: Restrict)
  logoAsset         MediaAsset?              @relation("StoreLogoAsset", fields: [logoAssetId], references: [id], onDelete: SetNull)
  bannerAsset       MediaAsset?              @relation("StoreBannerAsset", fields: [bannerAssetId], references: [id], onDelete: SetNull)
  mediaAssets       MediaAsset[]             @relation("StoreOwnedAssets")
  serviceAreas      StoreServiceArea[]
  products          Product[]
  serviceListings   ServiceListing[]
  carts             Cart[]
  orders            Order[]
  commissionLedgers    CommissionLedger[]
  settlements          SellerSettlementRecord[]
  reviews              Review[]
  conversations        Conversation[]
  subscription         StoreSubscription?
  subscriptionRenewals SubscriptionRenewalRequest[]
  promoDeals           StorePromoDeal[]

  @@index([districtId, status], map: "idx_stores_district_status")
  @@map("stores")
}

model StoreServiceArea {
  id                       String  @id @default(uuid()) @db.Uuid
  storeId                  String  @map("store_id") @db.Uuid
  areaZoneId               String  @map("area_zone_id") @db.Uuid
  deliveryFeeOverridePaisa BigInt? @map("delivery_fee_override_paisa")
  pickupSupported          Boolean @default(true) @map("pickup_supported")
  deliverySupported        Boolean @default(true) @map("delivery_supported")

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  areaZone AreaZone @relation(fields: [areaZoneId], references: [id], onDelete: Restrict)

  @@unique([storeId, areaZoneId])
  @@map("store_service_areas")
}

model Address {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  districtId     String    @map("district_id") @db.Uuid
  areaZoneId     String?   @map("area_zone_id") @db.Uuid
  label          String?   @db.VarChar(60)
  recipientName  String    @map("recipient_name") @db.VarChar(120)
  recipientPhone String    @map("recipient_phone") @db.VarChar(20)
  streetAddress  String    @map("street_address")
  landmark       String?
  isDefault      Boolean   @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  district District  @relation(fields: [districtId], references: [id], onDelete: Restrict)
  areaZone AreaZone? @relation(fields: [areaZoneId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_addresses_user_id")
  @@map("addresses")
}

// ============================================================================
// 3. CATALOG & MEDIA
// ============================================================================

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  parentId     String?  @map("parent_id") @db.Uuid
  applicableTo String   @map("applicable_to") @db.VarChar(20)
  slug         String   @unique @db.VarChar(100)
  nameEn       String   @map("name_en") @db.VarChar(100)
  nameUr       String   @map("name_ur") @db.VarChar(100)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent          Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]       @relation("CategoryHierarchy")
  products        Product[]
  serviceListings ServiceListing[]
  commissionRules CommissionRule[]
  buyerRequests   BuyerRequest[]

  @@map("categories")
}

model MediaAsset {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @map("owner_user_id") @db.Uuid
  storeId     String?  @map("store_id") @db.Uuid
  objectKey   String   @unique @map("object_key") @db.VarChar(512)
  mimeType    String   @map("mime_type") @db.VarChar(80)
  sizeBytes   Int      @map("size_bytes")
  exifStripped Boolean @default(false) @map("exif_stripped")
  status      String   @default("PENDING_UPLOAD") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ownerUser     User           @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  store         Store?         @relation("StoreOwnedAssets", fields: [storeId], references: [id], onDelete: SetNull)
  storeLogos    Store[]        @relation("StoreLogoAsset")
  storeBanners  Store[]        @relation("StoreBannerAsset")
  productImages ProductImage[]
  chatMessages  ChatMessage[]

  @@map("media_assets")
}

model Product {
  id              String                   @id @default(uuid()) @db.Uuid
  storeId         String                   @map("store_id") @db.Uuid
  categoryId      String                   @map("category_id") @db.Uuid
  slug            String                   @db.VarChar(160)
  title           String                   @db.VarChar(200)
  description     String
  basePricePaisa  BigInt                   @map("base_price_paisa")
  currency        String                   @default("PKR") @db.Char(3)
  stockQuantity   Int                      @default(0) @map("stock_quantity")
  hasVariants     Boolean                  @default(false) @map("has_variants")
  deliveryEnabled Boolean                  @default(true) @map("delivery_enabled")
  pickupEnabled   Boolean                  @default(true) @map("pickup_enabled")
  status          String                   @default("DRAFT") @db.VarChar(30)
  rejectionReason String?                  @map("rejection_reason")
  searchVector    Unsupported("tsvector")? @map("search_vector")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?                @map("deleted_at") @db.Timestamptz(6)

  store      Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants   ProductVariant[]
  images     ProductImage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  conversations Conversation[]
  chatMessages  ChatMessage[]

  @@index([storeId, status], map: "idx_products_store_status")
  @@index([categoryId, status], map: "idx_products_category_status")
  @@map("products")
}

model ProductVariant {
  id               String    @id @default(uuid()) @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  sku              String?   @db.VarChar(80)
  title            String    @db.VarChar(120)
  optionValuesJson Json      @map("option_values_json") @db.JsonB
  pricePaisa       BigInt    @map("price_paisa")
  stockQuantity    Int       @default(0) @map("stock_quantity")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("product_variants")
}

model ProductImage {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  mediaAssetId String  @map("media_asset_id") @db.Uuid
  sortOrder    Int     @default(0) @map("sort_order")
  isPrimary    Boolean @default(false) @map("is_primary")
  altText      String? @map("alt_text") @db.VarChar(200)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@map("product_images")
}

model ServiceListing {
  id                 String                   @id @default(uuid()) @db.Uuid
  storeId            String                   @map("store_id") @db.Uuid
  categoryId         String                   @map("category_id") @db.Uuid
  slug               String                   @db.VarChar(160)
  title              String                   @db.VarChar(200)
  description        String
  serviceMode        String                   @map("service_mode") @db.VarChar(20)
  requirementsPrompt String?                  @map("requirements_prompt")
  status             String                   @default("DRAFT") @db.VarChar(30)
  rejectionReason    String?                  @map("rejection_reason")
  searchVector       Unsupported("tsvector")? @map("search_vector")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?                @map("deleted_at") @db.Timestamptz(6)

  store               Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category            Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  packages            ServicePackage[]
  serviceOrderDetails ServiceOrderDetails[]
  conversations       Conversation[]
  chatMessages        ChatMessage[]

  @@index([storeId, status], map: "idx_services_store_status")
  @@map("service_listings")
}

model ServicePackage {
  id                    String    @id @default(uuid()) @db.Uuid
  serviceListingId      String    @map("service_listing_id") @db.Uuid
  tierName              String    @map("tier_name") @db.VarChar(60)
  description           String
  pricePaisa            BigInt    @map("price_paisa")
  currency              String    @default("PKR") @db.Char(3)
  deliveryEstimateDays  Int       @map("delivery_estimate_days")
  maxRevisions          Int       @default(0) @map("max_revisions")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  serviceListing      ServiceListing        @relation(fields: [serviceListingId], references: [id], onDelete: Restrict)
  serviceOrderDetails ServiceOrderDetails[]

  @@map("service_packages")
}

// ============================================================================
// 4. CART, ORDERS, DELIVERY & WORKFLOW HISTORY
// ============================================================================

model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  currency   String   @default("PKR") @db.Char(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@unique([customerId, storeId])
  @@map("carts")
}

model CartItem {
  id               String   @id @default(uuid()) @db.Uuid
  cartId           String   @map("cart_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  productVariantId String?  @map("product_variant_id") @db.Uuid
  quantity         Int
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart           Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@map("cart_items")
}

model Order {
  id                        String    @id @default(uuid()) @db.Uuid
  orderNumber               String    @unique @map("order_number") @db.VarChar(30)
  customerId                String    @map("customer_id") @db.Uuid
  storeId                   String    @map("store_id") @db.Uuid
  districtId                String    @map("district_id") @db.Uuid
  orderType                 String    @map("order_type") @db.VarChar(20)
  status                    String    @db.VarChar(30)
  paymentMethod             String    @default("COD") @map("payment_method") @db.VarChar(20)
  codCollectionStatus       String    @default("PENDING_COLLECTION") @map("cod_collection_status") @db.VarChar(30)
  currency                  String    @default("PKR") @db.Char(3)
  subtotalPaisa             BigInt    @map("subtotal_paisa")
  deliveryFeePaisa          BigInt    @default(0) @map("delivery_fee_paisa")
  discountPaisa             BigInt    @default(0) @map("discount_paisa")
  appliedPromoCode          String?   @map("applied_promo_code") @db.VarChar(40)
  totalPaisa                BigInt    @map("total_paisa")
  commissionRuleId          String    @map("commission_rule_id") @db.Uuid
  commissionRateBps         Int       @map("commission_rate_bps")
  commissionAmountPaisa     BigInt    @map("commission_amount_paisa")
  sellerNetEntitlementPaisa BigInt    @map("seller_net_entitlement_paisa")
  customerNote              String?   @map("customer_note")
  cancelledReason           String?   @map("cancelled_reason")
  completedAt               DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer            User                 @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  store               Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  district            District             @relation(fields: [districtId], references: [id], onDelete: Restrict)
  commissionRule      CommissionRule       @relation(fields: [commissionRuleId], references: [id], onDelete: Restrict)
  items               OrderItem[]
  serviceOrderDetails ServiceOrderDetails?
  delivery            Delivery?
  statusHistory       OrderStatusHistory[]
  messages            OrderMessage[]
  payments            Payment[]
  refunds             Refund[]
  commissionLedgers     CommissionLedger[]
  reviews               Review[]
  disputes              Dispute[]
  acceptedOfferMessages ChatMessage[]        @relation("AcceptedOfferOrder")

  @@index([customerId, createdAt(sort: Desc)], map: "idx_orders_customer_created")
  @@index([storeId, status, createdAt(sort: Desc)], map: "idx_orders_store_status_created")
  @@index([districtId, createdAt], map: "idx_orders_district_created")
  @@map("orders")
}

model OrderItem {
