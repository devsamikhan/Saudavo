{
  "name": "@saudavo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Saudavo modular-monolith NestJS REST API (/api/v1)",
  "scripts": {
    "dev": "nest start --watch",
    "dev:preview": "tsc && node dist/test/helpers/preview-server.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:seed": "tsx prisma/seed.ts",
    "auth:recover": "tsx prisma/recover-account.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.2.1",
    "@saudavo/contracts": "workspace:*",
    "@vercel/blob": "^2.9.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@saudavo/config": "workspace:*",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
