# ==============================================================================
# Saudavo — Environment Variables Example (Safe Placeholders Only)
# Copy to .env for local development. Never commit real secrets or .env files.
# ==============================================================================

# Environment
NODE_ENV=development

# API Server (apps/api)
API_PORT=4000
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# PostgreSQL (Prisma - Milestone 2B+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saudavo_dev?schema=public

# Sessions & Auth (Milestone 2B+)
SESSION_SECRET=replace-with-min-32-char-random-secret
CSRF_SECRET=replace-with-min-32-char-random-secret
MFA_ENCRYPTION_KEY=replace-with-min-32-char-random-secret
OUTBOX_ENCRYPTION_KEY=replace-with-min-32-char-random-secret

# Web Client (apps/web — Vercel Deployment Ready)
# When deploying Web on Vercel with a separate API host, set:
#   NEXT_PUBLIC_API_BASE_URL=/api/v1
#   API_PROXY_TARGET=https://your-saudavo-api-host
# so auth cookies stay 100% first-party same-origin across mobile browsers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
API_PROXY_TARGET=
NEXT_PUBLIC_ANDROID_APK_URL=https://github.com/devsamikhan/Saudavo/releases/latest
NEXT_PUBLIC_ANDROID_APK_VERSION=1.0.1

# S3-Compatible Object Storage (Cloudflare R2 Free 10GB / MinIO), Vercel Blob ("vercel-blob"), OR Local Disk ("local")
STORAGE_DRIVER=local
LOCAL_MEDIA_DIR=./storage/media
API_PUBLIC_URL=http://localhost:4000
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=saudavo-media-private
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-s3-secret-key

# Observability (Milestone 7+)
SENTRY_DSN=

# Transactional Email (Password Reset Delivery)
RESEND_API_KEY=
MAIL_FROM=noreply@saudavo.pk

# Zero-Gateway Monthly Seller Billing Display Instructions
SAUDAVO_BILLING_ACCOUNT_TITLE=Saudavo Marketplace
SAUDAVO_BILLING_RAAST_ID=
SAUDAVO_BILLING_WALLET_NUMBER=
